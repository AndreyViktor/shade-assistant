{
  "name": "meeting-copilot",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "11.0.1"
  },
  "description": "Assistente local de reuniões — scaffold desktop",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.tooling.json",
    "test": "vitest run",
    "test:runner": "python3 -m unittest discover -s tests/runner -p 'test_*.py' -v",
    "test:smoke": "npm run build && playwright test",
    "test:helper": "sh scripts/test-native-helper.sh",
    "verify:swift": "sh scripts/verify-swift.sh",
    "probe:swift": "swift run --package-path native/macos MeetingCopilotCapabilities",
    "build": "electron-vite build",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:runner && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.21",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
